{
  "manifest_version": 3,
  "name": "Hotel Collection",
  "version": "1.6.3",
  "description": "Curate Google Hotels into a shareable collection with map view, export, and import.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.google.com/travel/*",
    "https://google.com/travel/*",
    "https://*.google.com/travel/*",
    "https://www.google.co.in/travel/*",
    "https://*.google.co.in/travel/*",
    "https://www.google.co.uk/travel/*",
    "https://www.google.com.au/travel/*",
    "https://www.google.ca/travel/*",
    "https://www.google.com/maps/*",
    "https://*.google.com/maps/*",
    "https://www.google.co.in/maps/*",
    "https://*.tile.openstreetmap.org/*"
  ],
  "action": {
    "default_title": "Hotel Collection",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/travel/*",
        "https://google.com/travel/*",
        "https://*.google.com/travel/*",
        "https://www.google.co.in/travel/*",
        "https://*.google.co.in/travel/*",
        "https://www.google.co.uk/travel/*",
        "https://www.google.com.au/travel/*",
        "https://www.google.ca/travel/*",
        "https://www.google.com/maps/*",
        "https://*.google.com/maps/*",
        "https://www.google.co.in/maps/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
